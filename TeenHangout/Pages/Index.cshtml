@page
@model IndexModel

@{
    // Sets the title of the webpage
    ViewData["Title"] = "Teen Hangout";
}

<div class="container mt-4">

    <!-- Main page title -->
    <h1 class="text-center text-primary">Teen Hangout</h1>
    <p class="text-center">Your virtual space to connect!</p>

    <!-- MEMBERS SECTION -->
    <div class="card my-4">
        <div class="card-body">
            <h2>Our Members</h2>

            <!-- Loop through each user in the Users array -->
            @for (int i = 0; i < Model.Users.Length; i++)
            {
                <div class="alert alert-secondary">

                    <!-- Display user details -->
                    <strong>@Model.Users[i].Username</strong> - 
                    Age: @Model.Users[i].Age - 
                    Favorite Color: @Model.Users[i].FavoriteColor

                </div>
            }
        </div>
    </div>

    <!-- RECENT POSTS SECTION -->
    <div class="card my-4">
        <div class="card-body">
            <h2>Recent Posts</h2>

            <!-- Loop through all posts -->
            @for (int i = 0; i < Model.Posts.Length; i++)
            {
                <div class="alert alert-info">

                    <!-- Show post creator -->
                    <strong>@Model.Posts[i].Username</strong>

                    <!-- Show post content -->
                    <p>@Model.Posts[i].Content</p>

                    <!-- Show number of likes -->
                    <small>Likes: @Model.Posts[i].Likes</small>

                </div>
            }
        </div>
    </div>

    <!-- POPULAR POSTS SECTION -->
    <div class="card my-4">
        <div class="card-body">
            <h2>Popular Posts (20+ Likes)</h2>

            <!-- Loop through posts again -->
            @for (int i = 0; i < Model.Posts.Length; i++)
            {
                // Only display posts with 20 or more likes
                @if (Model.Posts[i].Likes >= 20)
                {
                    <div class="alert alert-success">

                        <strong>@Model.Posts[i].Username</strong>
                        <p>@Model.Posts[i].Content</p>
                        <strong>Likes: @Model.Posts[i].Likes</strong>

                    </div>
                }
            }
        </div>
    </div>

</div>